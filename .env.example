# Docker / Node
SCRIPT_HUB_IMAGE=ghcr.io/snail468/script-hub:latest
SCRIPT_HUB_PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-token
DB_PATH=./data/script-hub.db

# Comma-separated HTTPS hosts allowed for server-side import. Avoid "*" in production.
IMPORT_HOSTS=raw.githubusercontent.com,gist.githubusercontent.com,gitlab.com,bitbucket.org
MAX_SCRIPT_BYTES=262144

# Cloudflare CLI / CI (do not commit real values)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=script-hub
CLOUDFLARE_D1_NAME=script-hub
