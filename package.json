{
  "name": "script-hub",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted Linux and Windows script library for Docker and Cloudflare Workers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snail468/script-hub.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite --host 0.0.0.0\" \"tsx watch server/node.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/node.ts",
    "build:web": "vite build",
    "build:node": "esbuild server/node.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist-server/node.js",
    "build": "pnpm run build:web && pnpm run build:node",
    "start": "node dist-server/node.js",
    "check": "tsc --noEmit && eslint .",
    "test": "esbuild server/api.ts --bundle --platform=node --target=node22 --format=esm --outfile=.test-dist/api.js && node --test tests/*.test.mjs",
    "cf:dev": "pnpm run build:web && wrangler dev",
    "cf:deploy": "node scripts/deploy-cloudflare.mjs",
    "cf:migrate:local": "wrangler d1 migrations apply script-hub --local"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "lucide-react": "1.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "esbuild": "0.27.3",
    "globals": "16.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
